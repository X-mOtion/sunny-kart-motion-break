{
  "manifest_version": 3,
  "name": "Sunny Kart - Motion Break",
  "version": "1.0.2",
  "description": "A short motion-driving break. Tilt your head to change lanes, lean your shoulders to turn, and shrug to boost. Plays locally.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "Open Sunny Kart",
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}
  },
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "background": {"service_worker": "background.js"},
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'; worker-src 'self';"
  }
}
